# ==============================================================================
# AI Natural Language Test Automation - Configuration
# ==============================================================================

# LLM Provider: 'mock' (default for offline/deterministic), 'gemini', or 'openai'
LLM_PROVIDER=mock

# Gemini Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Compatible Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1  # Optional: For local Ollama / vLLM

# Browser Execution Settings
HEADLESS=false
SLOW_MO_MS=300
BROWSER_TYPE=chromium
DEFAULT_TIMEOUT_MS=10000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Execution Safeguards
MAX_ACTIONS=30
MAX_DURATION_SEC=120
NAVIGATION_SCOPE_ENFORCEMENT=true

# Reporting & Evidence
REPORTS_DIR=reports
SCREENSHOTS_DIR=reports/screenshots
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ON_STEP=false

